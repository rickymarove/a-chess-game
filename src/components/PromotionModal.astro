<!-- PAWN PROMOTION MODAL -->
<div
    id="promotion-modal"
    class="fixed inset-0 z-30 hidden items-center justify-center bg-black/60 backdrop-blur-sm"
>
    <div class="bg-slate-950/90 backdrop-blur-xl p-6 rounded-2xl border border-white/10 max-w-sm w-full mx-4 text-center shadow-2xl shadow-black/60">
        <h2 class="text-base font-semibold text-slate-100 mb-1">
            Promote Pawn
        </h2>
        <p class="text-xs text-slate-400 mb-5">
            Select a piece to promote to
        </p>
        <div class="grid grid-cols-2 gap-2.5">
            <button
                data-promo="q"
                class="promo-choice active relative flex flex-col items-center justify-center gap-1.5 px-3 py-3 rounded-xl text-xs font-medium text-slate-300 bg-white/5 border border-white/10 transition-colors duration-150 cursor-pointer hover:bg-white/10 hover:text-white [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/25"
            >
                <span class="material-symbols-outlined text-2xl! leading-none! text-slate-100">
                    crown
                </span>
                <span>Queen</span>
            </button>
            <button
                data-promo="r"
                class="promo-choice relative flex flex-col items-center justify-center gap-1.5 px-3 py-3 rounded-xl text-xs font-medium text-slate-300 bg-white/5 border border-white/10 transition-colors duration-150 cursor-pointer hover:bg-white/10 hover:text-white [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/25"
            >
                <span class="material-symbols-outlined text-2xl! leading-none! text-slate-100">
                    fort
                </span>
                <span>Rook</span>
            </button>
            <button
                data-promo="b"
                class="promo-choice relative flex flex-col items-center justify-center gap-1.5 px-3 py-3 rounded-xl text-xs font-medium text-slate-300 bg-white/5 border border-white/10 transition-colors duration-150 cursor-pointer hover:bg-white/10 hover:text-white [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/25"
            >
                <span class="material-symbols-outlined text-2xl! leading-none! text-slate-100">
                    flare
                </span>
                <span>Bishop</span>
            </button>
            <button
                data-promo="n"
                class="promo-choice relative flex flex-col items-center justify-center gap-1.5 px-3 py-3 rounded-xl text-xs font-medium text-slate-300 bg-white/5 border border-white/10 transition-colors duration-150 cursor-pointer hover:bg-white/10 hover:text-white [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/25"
            >
                <span class="material-symbols-outlined text-2xl! leading-none! text-slate-100">
                    bedroom_baby
                </span>
                <span>Knight</span>
            </button>
        </div>
    </div>
</div>
