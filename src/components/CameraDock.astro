<!-- BOTTOM CAMERA & VIEW PRESET DOCK -->
<nav class="fixed bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1 p-1 rounded-xl bg-slate-950/70 backdrop-blur-xl border border-white/10 shadow-lg shadow-black/30 max-w-[96vw] overflow-x-auto">
    <button
        data-cam="white"
        class="cam-btn active relative inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-transparent border border-transparent transition-colors duration-150 cursor-pointer whitespace-nowrap hover:text-slate-200 hover:bg-white/5 active:scale-[0.98] [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/15"
    >
        <span class="material-symbols-outlined text-[16px]! leading-none!">
            south
        </span>
        <span>White</span>
    </button>
    <button
        data-cam="black"
        class="cam-btn relative inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-transparent border border-transparent transition-colors duration-150 cursor-pointer whitespace-nowrap hover:text-slate-200 hover:bg-white/5 active:scale-[0.98] [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/15"
    >
        <span class="material-symbols-outlined text-[16px]! leading-none!">
            north
        </span>
        <span>Black</span>
    </button>
    <button
        data-cam="top"
        class="cam-btn relative inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-transparent border border-transparent transition-colors duration-150 cursor-pointer whitespace-nowrap hover:text-slate-200 hover:bg-white/5 active:scale-[0.98] [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/15"
    >
        <span class="material-symbols-outlined text-[16px]! leading-none!">
            grid_view
        </span>
        <span class="hidden sm:inline">Top</span>
    </button>
    <button
        data-cam="cinematic"
        class="cam-btn relative inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-transparent border border-transparent transition-colors duration-150 cursor-pointer whitespace-nowrap hover:text-slate-200 hover:bg-white/5 active:scale-[0.98] [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/15"
    >
        <span class="material-symbols-outlined text-[16px]! leading-none!">
            360
        </span>
        <span class="hidden sm:inline">Orbit</span>
    </button>

    <div class="h-4 w-px bg-white/10 mx-1"></div>

    <button
        id="btn-battle-cam"
        class="active relative inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-transparent border border-transparent transition-colors duration-150 cursor-pointer whitespace-nowrap hover:text-slate-200 hover:bg-white/5 active:scale-[0.98] [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/15"
        title="Follow Move Focus"
    >
        <span class="material-symbols-outlined text-[16px]! leading-none!">
            videocam
        </span>
        <span class="hidden md:inline">Auto Cam</span>
    </button>
</nav>
