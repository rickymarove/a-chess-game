<!-- FLOATING STATUS / ACTION BANNER (Non-blocking subtle announcement beneath top bar) -->
<div class="fixed left-1/2 -translate-x-1/2 z-20 pointer-events-none mt-20">
    <div
        id="action-toast"
        class="px-4 py-1.5 rounded-full bg-[#14161F]/76 backdrop-blur-[18px] border border-amber-500/30 text-xs md:text-sm font-medium text-amber-200 flex items-center gap-2 opacity-0 -translate-y-2 shadow-[0_12px_40px_-10px_rgba(0,0,0,0.7),0_0_1px_1px_rgba(255,255,255,0.04)_inset] transition-all duration-350 ease-[cubic-bezier(0.16,1,0.3,1)]"
    >
        <span
            class="material-symbols-outlined text-[19px]! leading-none! text-amber-400"
            id="toast-icon"
        >
            auto_fix_high
        </span>
        <span id="toast-text">Select a carved stone piece to command</span>
    </div>
</div>
