<!-- TOP NAVIGATION BAR (Minimalist App Bar) -->
<header class="fixed top-3 left-3 right-3 md:left-6 md:right-6 z-20 flex items-center justify-between px-3 md:px-4 h-14 rounded-xl bg-slate-950/70 backdrop-blur-xl border border-white/10 shadow-lg shadow-black/30">
    <!-- Left: Game Mode Switcher -->
    <div class="flex items-center gap-2">
        <button
            id="btn-mode"
            class="active relative inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 bg-white/5 border border-white/10 transition-colors duration-150 cursor-pointer whitespace-nowrap hover:bg-white/10 hover:text-white active:scale-[0.98] [&.active]:bg-white/15 [&.active]:text-white [&.active]:border-white/20"
            title="Switch between AI and 2-Player Local"
        >
            <span
                class="material-symbols-outlined text-[17px]! leading-none!"
                id="mode-icon"
            >
                smart_toy
            </span>
            <span id="mode-label">vs AI</span>
        </button>
    </div>

    <!-- Center: Turn Status & Captures (True Centered) -->
    <div class="absolute left-1/2 -translate-x-1/2 flex items-center pointer-events-auto">
        <div
            id="turn-pill"
            class="flex items-center gap-2 sm:gap-2.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 transition-colors duration-200 shadow-sm"
        >
            <!-- White Captures -->
            <div
                class="flex items-center gap-1.5 text-xs text-slate-400"
                title="White captures"
            >
                <span class="w-1.5 h-1.5 rounded-full bg-slate-200 inline-block"></span>
                <span class="font-medium text-slate-400 text-[11px]">W</span>
                <span
                    id="white-captures"
                    class="font-mono tabular-nums text-slate-200 font-medium text-xs"
                >
                    0
                </span>
            </div>

            <!-- Hairline Divider -->
            <div class="h-3 w-px bg-white/10"></div>

            <!-- Active Turn & Move -->
            <div class="flex items-center gap-1.5">
                <span
                    id="turn-dot"
                    class="w-2 h-2 rounded-full bg-slate-100"
                ></span>
                <span
                    id="turn-text"
                    class="text-xs font-semibold tracking-normal text-slate-100 whitespace-nowrap"
                >
                    White's Turn
                </span>
                <span class="text-slate-600 text-xs hidden sm:inline">•</span>
                <span
                    id="move-counter"
                    class="hidden sm:inline font-mono tabular-nums text-[11px] text-slate-400"
                >
                    Move 1
                </span>
            </div>

            <!-- Hairline Divider -->
            <div class="h-3 w-px bg-white/10"></div>

            <!-- Black Captures -->
            <div
                class="flex items-center gap-1.5 text-xs text-slate-400"
                title="Black captures"
            >
                <span class="w-1.5 h-1.5 rounded-full bg-slate-600 border border-slate-500 inline-block"></span>
                <span class="font-medium text-slate-400 text-[11px]">B</span>
                <span
                    id="black-captures"
                    class="font-mono tabular-nums text-slate-200 font-medium text-xs"
                >
                    0
                </span>
            </div>
        </div>
    </div>

    <!-- Right: Actions -->
    <div class="flex items-center gap-1 md:gap-1.5">
        <button
            id="btn-demo-strike"
            class="relative inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-white/4 border border-white/8 transition-colors duration-150 cursor-pointer whitespace-nowrap hover:bg-white/10 hover:text-slate-200 active:scale-[0.98]"
            title="Demonstration Move"
        >
            <span class="material-symbols-outlined text-[17px]! leading-none!">
                bolt
            </span>
            <span class="hidden md:inline">Demo</span>
        </button>

        <button
            id="btn-undo"
            class="relative inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-white/4 border border-white/8 transition-colors duration-150 cursor-pointer whitespace-nowrap hover:bg-white/10 hover:text-slate-200 active:scale-[0.98]"
            title="Undo Move"
        >
            <span class="material-symbols-outlined text-[17px]! leading-none!">
                undo
            </span>
            <span class="hidden lg:inline">Undo</span>
        </button>

        <button
            id="btn-reset"
            class="relative inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-white/4 border border-white/8 transition-colors duration-150 cursor-pointer whitespace-nowrap hover:bg-white/10 hover:text-slate-200 active:scale-[0.98]"
            title="New Game"
        >
            <span class="material-symbols-outlined text-[17px]! leading-none!">
                restart_alt
            </span>
            <span class="hidden lg:inline">New</span>
        </button>

        <button
            id="btn-sound"
            class="active relative inline-flex items-center justify-center p-2 rounded-lg text-xs font-medium text-slate-400 bg-white/4 border border-white/8 transition-colors duration-150 cursor-pointer whitespace-nowrap hover:bg-white/10 hover:text-slate-200 active:scale-[0.98] [&.active]:text-slate-200 [&.active]:bg-white/8"
            title="Toggle Sound"
        >
            <span
                class="material-symbols-outlined text-[17px]! leading-none!"
                id="sound-icon"
            >
                volume_up
            </span>
        </button>
    </div>
</header>
