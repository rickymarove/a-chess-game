---
import Layout from "../layouts/Layout.astro";
import ChessCanvas from "../components/ChessCanvas.astro";
import TopBar from "../components/TopBar.astro";
import ActionToast from "../components/ActionToast.astro";
import CameraDock from "../components/CameraDock.astro";
import PromotionModal from "../components/PromotionModal.astro";
---

<Layout title="Wizard's Chess 3D — Sanctuary of Stone & Shadow">
    <ChessCanvas />
    <TopBar />
    <ActionToast />
    <CameraDock />
    <PromotionModal />

    <script>
        import { initWizardChess } from "../scripts/wizardChess.js";

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initWizardChess);
        } else {
            initWizardChess();
        }
    </script>
</Layout>
